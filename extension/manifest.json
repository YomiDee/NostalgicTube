{
  "manifest_version": 3,
  "name": "NostalgicTube",
  "version": "0.2.0",
  "description": "Your saved interests and discoveries from another era, in YouTube's native home feed.",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "NostalgicTube"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "native.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "dates.js",
        "search.js",
        "i18n.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ]
    }
  ]
}
